{
  "name": "desktop-notes",
  "productName": "Desktop Notes",
  "version": "1.0.0",
  "description": "A local-first desktop note-taking app built with Electron, React, Vite and Tailwind CSS.",
  "homepage": "https://example.com/desktop-notes",
  "author": "Rahim <rahim@example.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:renderer": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node tests/e2e/smoke.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder -wml --x64 --arm64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.55.0",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  }
}
